// Google Sign-In URL scheme for the DEV flavor (macOS). Copy to
// macos/Runner/Configs/FirebaseSecrets-dev.xcconfig (tool/bootstrap.sh does it)
// and paste the REVERSED_CLIENT_ID of your DEV Firebase iOS/macOS app
// (see docs/FIREBASE_SETUP.md). The prod value stays in FirebaseSecrets.xcconfig.
// The real file is gitignored.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.REPLACE_ME
