{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "//": "Built by tool/build_site.sh: the static landing at the root, the Flutter app under /app/. Deploying build/web directly would put the app back at / and strand the landing.",
    "public": "build/site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "//": "Only the app needs SPA routing — go_router owns everything under /app/. The landing is real files, so it must NOT be rewritten: a catch-all here would answer /en/ and every 404 with the app shell, costing a visitor 3.4 MB to be told nothing.",
        "source": "/app/**",
        "destination": "/app/index.html"
      }
    ],
    "headers": [
      {
        "//": "There is deliberately no Cross-Origin-Opener-Policy here. Any value interferes with firebase_auth's signInWithPopup, which needs the opener link to get the Google credential back — sign-in was observed hanging with one set. The only value worth the risk would be 'same-origin', for the cross-origin isolation that lets drift use OPFS, and that is the value that breaks popups outright. drift uses IndexedDB, which measured no slower. Referrer-Policy is strict-origin-when-cross-origin rather than same-origin: the stricter value sends no origin at all to Google, which its OAuth endpoints may check.",
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "//": "connect-src is the directive that earns its keep: the local database is not encrypted (see connection_web.dart), so the risk the browser adds over native is script injection reading it — and this pins where anything can be sent to. An attacker who lands script here still cannot POST the congregation to a host of their choosing. script-src keeps 'unsafe-inline' because Flutter's bootstrap emits inline scripts; dropping it needs per-release hashes that break on every engine bump, so this policy does NOT claim to stop XSS execution, only its exfiltration. Verified against a real load: fonts.gstatic.com is CanvasKit fetching its Roboto fallback and accounts.google.com is google_sign_in_web injecting the GSI client on registration, both of which the engine requires even though web signs in through firebase_auth's popup. www.gstatic.com serves the Firebase JS SDK that firebase_core loads at runtime — without it cloud mode cannot start at all, which is the whole of web. The landing needs none of this: its own needs are a strict subset ('self' for script, style and font), and tightening it there is worth a follow-up.",
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline' https://www.gstatic.com https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self' https://fonts.gstatic.com; worker-src 'self' blob:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://fonts.gstatic.com https://www.gstatic.com https://accounts.google.com; frame-src https://accounts.google.com https://*.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
          }
        ]
      },
      {
        "//": "Scoped to /app/ on purpose. As `**` this pattern also matched /landing.js, which carries no content hash — a visitor who loaded the site once would have been pinned to that copy of the landing for a year, with no way to push a fix.",
        "source": "/app/**/*.@(wasm|js|mjs|ttf|otf|png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "//": "The landing's CSS and JS keep stable names, so they are revalidated rather than trusted. At ~11 KB gzipped for the whole page the conditional request costs a 304 and nothing else. Hashing these filenames in tool/build_site.py would let them be immutable too; worth doing if the page ever grows.",
        "source": "/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "//": "Subsets regenerated only when tool/subset_fonts.sh is run, which is rare, but the names are not hashed either — a month is long enough to never be fetched twice by a returning reader and short enough to self-heal.",
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "//": "Hashed engine and app payloads are immutable; HTML must never be, or a deploy leaves clients on the old build.",
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    }
  }
}
