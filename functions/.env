# Non-secret configuration for the mail callables. Committed on purpose: these
# values decide where mail comes from and where its links point, and a deploy
# should not be able to change them without the change showing up in a diff.
# The mailbox password is NOT here — it lives in Secret Manager as SMTP_PASS.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=noreply@agora.mobi
MAIL_FROM=Agora <noreply@agora.mobi>
SITE_ORIGIN=https://agora.mobi
